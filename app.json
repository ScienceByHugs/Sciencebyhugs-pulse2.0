{
  "expo": {
    "name": "Pulse",
    "slug": "pulse-2",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "pulse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sciencebyhugs.pulse"
    },
    "android": {
      "package": "com.sciencebyhugs.pulse",
      "adaptiveIcon": {
        "backgroundColor": "#07111f"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
